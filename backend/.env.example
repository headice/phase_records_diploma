# Django
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_USE_SQLITE=True

# PostgreSQL (used when DJANGO_USE_SQLITE=False)
POSTGRES_DB=phase_records
POSTGRES_USER=phase
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# YooKassa payment (test mode)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_RETURN_URL=http://localhost:3000/cart?payment=return

# Email delivery
# If EMAIL_HOST is empty, Django will print emails to the backend console.
# Supported EMAIL_PROVIDER values: mailru, gmail, yandex, custom
# For Mail.ru use an app password from account security settings.
EMAIL_PROVIDER=mailru
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=noreply@mail.ru
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Phase Records <noreply@mail.ru>

# Mail.ru preset:
# EMAIL_PROVIDER=mailru
# EMAIL_HOST_USER=your-box@mail.ru
# EMAIL_HOST_PASSWORD=your-app-password
#
# Gmail preset:
# EMAIL_PROVIDER=gmail
# EMAIL_HOST_USER=yourbox@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Phase Records <yourbox@gmail.com>
#
# Yandex preset:
# EMAIL_PROVIDER=yandex
# EMAIL_HOST_USER=yourbox@yandex.ru
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Phase Records <yourbox@yandex.ru>
#
# Custom SMTP:
# EMAIL_PROVIDER=custom
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
